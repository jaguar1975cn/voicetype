__pycache__/
*.pyc
.pytest_cache/

# Editor scratch files. A vim swap file embeds your username, hostname and
# absolute path, so committing one leaks all three.
*.swp
*.swo
*~
.*.sw[a-z]

# Personal voice recordings. Fixtures you record contain your own voice;
# keep them local. Tests that need one skip when it is absent.
tests/fixtures/mixed_zh_en.wav
tests/fixtures/*.local.wav
